{
    "name": "tobymaxham/laravel-properties",
    "description": "Flexible JSON properties for Eloquent models: defaults, casts, enums, encryption, query scopes and migration helpers.",
    "keywords": [
        "TobyMaxham",
        "laravel",
        "eloquent",
        "properties",
        "json",
        "settings",
        "schemaless",
        "casts"
    ],
    "homepage": "https://github.com/TobyMaxham/laravel-properties",
    "license": "MIT",
    "authors": [
        {
            "name": "TobyMaxham",
            "email": "git@maxham.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "TobyMaxham\\LaravelProperties\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TobyMaxham\\LaravelProperties\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TobyMaxham\\LaravelProperties\\LaravelPropertiesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage",
        "cs-fix": "./vendor/bin/pint src/ tests/",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
